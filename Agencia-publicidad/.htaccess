# Habilitar el motor de reescritura
RewriteEngine On

# Establecer la base de reescritura
RewriteBase /Agencia-publicidad/Agencia-publicidad/

# Páginas de error personalizadas (rutas relativas)
ErrorDocument 403 index.php?controller=OutController&accion=error403
ErrorDocument 404 index.php?controller=OutController&accion=error404
ErrorDocument 500 index.php?controller=OutController&accion=error500
ErrorDocument 503 index.php?controller=OutController&accion=error503

# Permitir acceso a archivos estáticos
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+)$ - [L]

# Redirigir todas las peticiones que no sean archivos/directorios al index.php
# RewriteRule ^(.*)$ index.php [QSA,L]
